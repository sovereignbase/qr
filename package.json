{
  "name": "@sovereignbase/qr",
  "version": "1.1.0",
  "description": "Simple managed QR display, print, and scan utilities for browser frontends.",
  "keywords": [
    "qr",
    "qrcode",
    "scanner",
    "browser",
    "frontend",
    "spa",
    "esm",
    "cjs",
    "typescript",
    "sovereignbase"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/qr.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/qr/issues"
  },
  "homepage": "https://sovereignbase.dev/qr",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "format": "prettier . --write",
    "build": "tsup && node in-browser-testing-build.js",
    "test": "npm run build && node test/run-coverage.mjs && node test/e2e/run.mjs",
    "prepare": "husky",
    "prepublishOnly": "npm run test"
  },
  "c8": {
    "all": true,
    "include": [
      "dist/**/*.js"
    ],
    "exclude": [
      "dist/**/*.d.ts",
      "test/**",
      "benchmark/**",
      "playwright.config.ts"
    ]
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "c8": "^11.0.0",
    "edge-runtime": "^4.0.1",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.84.0"
  },
  "dependencies": {
    "qr": "^0.5.5",
    "qr-scanner": "^1.4.2"
  }
}
